<%- include("../partials/header") %>

<section class="card">

    <h2>Login</h2>

    <% if (error.length > 0) { %>
        <div class="error">
            <%= error[0] %>
        </div>
    <% } %>

    <% if (success.length > 0) { %>
        <div class="success">
            <%= success[0] %>
        </div>
    <% } %>

    <form action="/login" method="POST">

        <label for="user_email">Email Address</label>

        <input
            type="email"
            id="user_email"
            name="user_email"
            required
        >

        <label for="user_password">Password</label>

        <input
            type="password"
            id="user_password"
            name="user_password"
            required
        >

        <br>

        <button class="btn" type="submit">
            Login
        </button>

    </form>

    <p>
        Don't have an account?
        <a href="/register">Create Account</a>
    </p>

</section>

<%- include("../partials/footer") %>