<%- include("partials/header") %>

<h2><%= title %></h2>

<p>
    Browse our service project categories to discover volunteer opportunities
    and community initiatives.
</p>

<div class="features">

<% categories.forEach(category => { %>

<div class="card">

    <h3>
        <a href="/category/<%= category.category_id %>">
            <%= category.name %>
        </a>
    </h3>

    <p>
        Explore projects related to <strong><%= category.name %></strong>.
    </p>

    <p>
        <a class="button" href="/category/<%= category.category_id %>">
            View Projects
        </a>
    </p>

</div>

<% }) %>

</div>

<%- include("partials/footer") %>