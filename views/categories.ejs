<%- include("partials/header") %>

<h2><%= title %></h2>

<p>Browse our service project categories.</p>

<div class="features">

<% categories.forEach(category => { %>

<div class="card">

    <h3>
        <a href="/category/<%= category.category_id %>">
            <%= category.name %>
        </a>
    </h3>

</div>

<% }) %>

</div>

<%- include("partials/footer") %>