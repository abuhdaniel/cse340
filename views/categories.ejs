<%- include("partials/header") %>

<h2><%= title %></h2>

<p>
    Browse our service project categories to discover volunteer opportunities
    and community initiatives.
</p>

<!-- Admin Only -->
<% if (user && user.role === "admin") { %>

<p>
    <a href="/new-category" class="button">
        ➕ Add Category
    </a>
</p>

<% } %>

<div class="features">

    <% categories.forEach(category => { %>

    <div class="card">

        <h3>
            <a href="/category/<%= category.category_id %>">
                <%= category.name %>
            </a>
        </h3>

        <p>
            Explore projects related to
            <strong><%= category.name %></strong>.
        </p>

        <div class="actions">

            <a class="button" href="/category/<%= category.category_id %>">
                View Projects
            </a>

            <!-- Admin Only -->
            <% if (user && user.role === "admin") { %>

            <a class="button" href="/edit-category/<%= category.category_id %>">
                ✏️ Edit Category
            </a>

            <% } %>

        </div>

    </div>

    <% }) %>

</div>

<%- include("partials/footer") %>