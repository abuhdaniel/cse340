<%- include("partials/header") %>

<h2><%= category.name %></h2>

<p>
    Browse all service projects in the
    <strong><%= category.name %></strong> category.
</p>

<% if (projects.length > 0) { %>

<div class="features">

    <% projects.forEach(project => { %>

    <div class="card">

        <h3>
            <a href="/project/<%= project.project_id %>">
                <%= project.name %>
            </a>
        </h3>

        <p>
            <strong>Description:</strong><br>
            <%= project.description %>
        </p>

        <p>
            <strong>Location:</strong>
            <%= project.location %>
        </p>

        <p>
            <strong>Project Date:</strong>
            <%= new Date(project.project_date).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric"
            }) %>
        </p>

        <p>
            <a class="button" href="/project/<%= project.project_id %>">
                View Project
            </a>
        </p>

    </div>

    <% }) %>

</div>

<% } else { %>

<p>No projects are currently assigned to this category.</p>

<% } %>

<%- include("partials/footer") %>