<%- include("partials/header") %>

<h2>Edit Category</h2>

<% if (typeof errors !== "undefined" && errors.length > 0) { %>
<div class="error-message">
    <ul>
        <% errors.forEach(error => { %>
            <li><%= error.msg %></li>
        <% }) %>
    </ul>
</div>
<% } %>

<form action="/edit-category/<%= category.category_id %>" method="POST" class="form">

    <label for="name">
        Category Name
    </label>

    <input
        type="text"
        id="name"
        name="name"
        value="<%= category.name %>"
        required
        maxlength="100">

    <button type="submit">
        Update Category
    </button>

    <a href="/category/<%= category.category_id %>" class="button">
        Cancel
    </a>

</form>

<%- include("partials/footer") %>