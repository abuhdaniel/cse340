<%- include("partials/header") %>

<h2>Create New Category</h2>

<p>Create a new service category below.</p>

<% if (errors && errors.length > 0) { %>

<div class="card">
    <ul>
        <% errors.forEach(error => { %>
            <li><%= error.msg %></li>
        <% }) %>
    </ul>
</div>

<% } %>

<form action="/new-category" method="POST">

    <label for="name">
        Category Name
    </label>

    <input
        type="text"
        id="name"
        name="name"
        value="<%= name %>"
        required
        maxlength="100"
    >

    <br><br>

    <button class="button" type="submit">
        Create Category
    </button>

    <a href="/categories" class="button secondary">
        Cancel
    </a>

</form>

<%- include("partials/footer") %>