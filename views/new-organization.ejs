<%- include("partials/header") %>

<h2>Create New Organization</h2>

<p>Complete the form below to add a new organization.</p>

<% if (errors && errors.length > 0) { %>
<div class="card">
    <ul>
        <% errors.forEach(error => { %>
            <li><%= error.msg %></li>
        <% }) %>
    </ul>
</div>
<% } %>

<form action="/new-organization" method="POST">

    <label for="name">
        Organization Name
    </label>

    <input
        type="text"
        id="name"
        name="name"
        required
        maxlength="100"
        value="<%= organization?.name || '' %>"
    >

    <label for="description">
        Description
    </label>

    <textarea
        id="description"
        name="description"
        rows="5"
        required
    ><%= organization?.description || '' %></textarea>

    <label for="contact_email">
        Contact Email
    </label>

    <input
        type="email"
        id="contact_email"
        name="contact_email"
        required
        value="<%= organization?.contact_email || '' %>"
    >

    <br><br>

    <button class="button" type="submit">
        Create Organization
    </button>

    <a href="/organizations" class="button secondary">
        Cancel
    </a>

</form>

<%- include("partials/footer") %>