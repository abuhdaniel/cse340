<%- include("partials/header") %>

<h2><%= organization.name %></h2>

<div class="card">

    <img
        src="/images/<%= organization.logo_filename %>"
        alt="<%= organization.name %> Logo"
        class="organization-image"
    >

    <p>
        <strong>Description:</strong><br>
        <%= organization.description %>
    </p>

    <p>
        <strong>Contact Email:</strong>
        <%= organization.contact_email %>
    </p>

</div>

<h3>Service Projects</h3>

<% if (projects.length > 0) { %>

<div class="features">

    <% projects.forEach(project => { %>

    <div class="card">

        <h4>
            <a href="/project/<%= project.project_id %>">
                <%= project.name %>
            </a>
        </h4>

        <p>
            <strong>Description:</strong><br>
            <%= project.description %>
        </p>

        <p>
            <strong>Location:</strong>
            <%= project.location %>
        </p>

        <p>
            <strong>Project Date:</strong>
            <%= new Date(project.project_date).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric"
            }) %>
        </p>

        <p>
            <a class="button" href="/project/<%= project.project_id %>">
                View Project
            </a>
        </p>

    </div>

    <% }) %>

</div>

<% } else { %>

<p>This organization currently has no service projects.</p>

<% } %>

<%- include("partials/footer") %>