<%- include("partials/header") %>

<h2><%= title %></h2>

<p>
    Explore organizations that are making a positive impact through community
    service projects.
</p>

<div class="features">

<% organizations.forEach(org => { %>

<div class="card">

    <img
        src="/images/<%= org.logo_filename %>"
        alt="<%= org.name %> Logo"
        class="organization-image"
    >

    <h3>
        <a href="/organization/<%= org.organization_id %>">
            <%= org.name %>
        </a>
    </h3>

    <p>
        <strong>Description:</strong><br>
        <%= org.description %>
    </p>

    <p>
        <strong>Contact Email:</strong><br>
        <%= org.contact_email %>
    </p>

    <p>
        <a class="button" href="/organization/<%= org.organization_id %>">
            View Organization
        </a>
    </p>

</div>

<% }) %>

</div>

<%- include("partials/footer") %>