<%- include("partials/header") %>

<h2><%= title %></h2>

<p>
    Explore organizations that are making a positive impact through community
    service projects.
</p>

<!-- Admin Only: Add Organization -->
<% if (user && user.role === "admin") { %>

<p>
    <a href="/new-organization" class="button">
        ➕ Add Organization
    </a>
</p>

<% } %>

<div class="features">

    <% organizations.forEach(org => { %>

    <div class="card">

        <img
            src="/images/<%= org.logo_filename %>"
            alt="<%= org.name %> Logo"
            class="organization-image"
        >

        <h3>
            <a href="/organization/<%= org.organization_id %>">
                <%= org.name %>
            </a>
        </h3>

        <p>
            <strong>Description:</strong><br>
            <%= org.description %>
        </p>

        <p>
            <strong>Contact Email:</strong><br>
            <%= org.contact_email %>
        </p>

        <div class="actions">

            <a class="button" href="/organization/<%= org.organization_id %>">
                View Organization
            </a>

            <% if (user && user.role === "admin") { %>

            <a class="button" href="/edit-organization/<%= org.organization_id %>">
                ✏️ Edit Organization
            </a>

            <% } %>

        </div>

    </div>

    <% }) %>

</div>

<%- include("partials/footer") %>