<%- include("partials/header") %>

<h2><%= title %></h2>

<p>Explore organizations that are making a positive impact in their communities.</p>

<div class="features">

    <% organizations.forEach(org => { %>

        <div class="card">

            <img
                src="/images/<%= org.logo_filename %>"
                alt="<%= org.name %>"
                class="organization-image"
            >

            <h3><%= org.name %></h3>

            <p><%= org.description %></p>

            <p>
                <strong>Contact:</strong>
                <%= org.contact_email %>
            </p>

        </div>

    <% }) %>

</div>

<%- include("partials/footer") %>