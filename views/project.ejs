<%- include("partials/header") %>

<h2><%= project.name %></h2>

<div class="card">

    <p>
        <strong>Description:</strong><br>
        <%= project.description %>
    </p>

    <p>
        <strong>Location:</strong>
        <%= project.location %>
    </p>

    <p>
        <strong>Project Date:</strong>
        <%= new Date(project.project_date).toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric"
        }) %>
    </p>

    <p>
        <strong>Organization:</strong>

        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>

    <h3>Categories</h3>

    <div class="categories">

        <% if (categories.length > 0) { %>

            <% categories.forEach(category => { %>

                <a href="/category/<%= category.category_id %>" class="tag">
                    <%= category.name %>
                </a>

            <% }) %>

        <% } else { %>

            <p>No categories assigned.</p>

        <% } %>

    </div>

    <hr>

    <div class="actions">

        <a href="/edit-project/<%= project.project_id %>" class="button">
            ✏️ Edit Project
        </a>

        <a href="/assign-categories/<%= project.project_id %>" class="button">
            🏷️ Assign Categories
        </a>

        <a href="/projects" class="button secondary">
            ⬅ Back to Projects
        </a>

    </div>

</div>

<%- include("partials/footer") %>