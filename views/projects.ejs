<%- include("partials/header") %>

<h2><%= title %></h2>

<p>Browse our current service projects.</p>

<div class="features">

<% projects.forEach(project => { %>

<div class="card">

    <h3>
        <a href="/project/<%= project.project_id %>">
            <%= project.name %>
        </a>
    </h3>

    <p><%= project.description %></p>

</div>

<% }) %>

</div>

<%- include("partials/footer") %>