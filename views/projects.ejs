<%- include("partials/header") %>

<h2><%= title %></h2>

<p>Browse our current and upcoming service projects.</p>

<div class="features">

<% projects.forEach(project => { %>

<div class="card">

    <h3>
        <a href="/project/<%= project.project_id %>">
            <%= project.name %>
        </a>
    </h3>

    <p><strong>Description:</strong> <%= project.description %></p>

    <p><strong>Location:</strong> <%= project.location %></p>

    <p>
        <strong>Date:</strong>
        <%= new Date(project.project_date).toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric"
        }) %>
    </p>

    <p>
        <a class="button" href="/project/<%= project.project_id %>">
            View Project Details
        </a>
    </p>

</div>

<% }) %>

</div>

<%- include("partials/footer") %>